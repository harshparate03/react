{
  "info": {
    "name": "Employee_REST_API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create record",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/employees",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Example name\", \"email\": \"asha@example.com\", \"department\": \"Example department\"}"
        }
      }
    },
    {
      "name": "GET employees",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/employees"
      }
    },
    {
      "name": "GET employees/1",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/employees/1"
      }
    },
    {
      "name": "DELETE employees/1",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:3000/employees/1"
      }
    }
  ]
}
